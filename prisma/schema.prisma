generator client {
  provider = "prisma-client"
  output   = "../lib/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * User & authentication
 */
model User {
  id String @id @default(uuid())

  name     String
  email    String @unique
  password String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions                 Session[]
  emailChangeVerifications EmailChangeVerification[]
  businessProfile          BusinessProfile?
  paymentMethods           PaymentMethod[]
  invoicingSettings        InvoicingSettings?
  invoiceCategories        InvoiceCategory[]
  currencies               Currency[]
  clients                  Client[]
  invoices                 Invoice[]

  @@map("users")
}

model Session {
  id     String @id @default(uuid())
  userId String @map("user_id")

  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailChangeVerification {
  id     String @id @default(uuid())
  userId String @map("user_id")

  newEmail String @map("new_email")
  code     String @map("code")
  attempts Int    @default(0)

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_change_verifications")
}

/**
 * Business profile
 */
model BusinessProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  businessName String? @map("business_name")
  email        String?
  phone        String?
  website      String?

  address    String?
  city       String?
  state      String?
  country    String?
  postalCode String? @map("postal_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

/**
 * Payment methods
 */
enum PaymentMethodType {
  BANK_TRANSFER
  UPI
  PAYPAL
  WISE
  OTHER
}

model PaymentMethod {
  id     String @id @default(uuid())
  userId String @map("user_id")

  name    String
  type    PaymentMethodType
  details Json

  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([userId])
  @@map("payment_methods")
}

/**
 * Invoicing settings
 */
model InvoicingSettings {
  id String @id @default(uuid())

  userId String @unique @map("user_id")

  invoicePrefix       String? @map("invoice_prefix")
  defaultCurrency     String? @map("default_currency")
  defaultPaymentTerms Int?    @map("default_payment_terms")
  defaultNotes        String? @map("default_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invoicing_settings")
}

/**
 * Invoice categories
 */
model InvoiceCategory {
  id     String @id @default(uuid())
  userId String @map("user_id")

  name        String
  code        String
  description String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@unique([userId, code])
  @@index([userId])
  @@map("invoice_categories")
}

/**
 * Currencies
 */
model Currency {
  id     String @id @default(uuid())
  userId String @map("user_id")

  code   String
  name   String
  symbol String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId])
  @@map("currencies")
}

/**
 * Clients
 */
model Client {
  id     String @id @default(uuid())
  userId String @map("user_id")

  name       String
  slug       String
  email      String
  company    String?
  phone      String?
  address    String?
  city       String?
  state      String?
  postalCode String? @map("postal_code")
  country    String?
  website    String?
  notes      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id])
  invoices Invoice[]

  @@unique([userId, slug])
  @@index([userId])
  @@map("clients")
}

/**
 * Invoices
 */
enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  CANCELLED
}

model Invoice {
  id     String @id @default(uuid())
  userId String @map("user_id")
  slug   String

  clientId          String? @map("client_id")
  invoiceCategoryId String? @map("invoice_category_id")
  paymentMethodId   String? @map("payment_method_id")

  invoiceNumber String        @map("invoice_number")
  status        InvoiceStatus @default(DRAFT)

  invoiceDate DateTime @map("invoice_date")
  dueDate     DateTime @map("due_date")

  currency String

  projectName        String? @map("project_name")
  projectDescription String? @map("project_description")

  discountPercentage Decimal @default(0) @map("discount_percentage")

  paymentReference String? @default("") @map("payment_reference")

  notes String?
  terms String?

  subtotal       Decimal @default(0)
  discountAmount Decimal @default(0) @map("discount_amount")
  grandTotal     Decimal @default(0) @map("grand_total")

  /**
   * Client snapshot
   * Preserves the client's billing information as it existed
   * when the invoice was created.
   */
  clientName       String  @map("client_name")
  clientEmail      String  @map("client_email")
  clientCompany    String? @map("client_company")
  clientPhone      String? @map("client_phone")
  clientAddress    String? @map("client_address")
  clientCity       String? @map("client_city")
  clientState      String? @map("client_state")
  clientPostalCode String? @map("client_postal_code")
  clientCountry    String? @map("client_country")

  /**
   * Payment Method Snapshot
   * Preserves the payment method information used by the
   * invoice even if the original payment method is modified
   * or deleted later.
   */
  paymentMethodName    String?            @map("payment_method_name")
  paymentMethodType    PaymentMethodType? @map("payment_method_type")
  paymentMethodDetails Json?              @map("payment_method_details")

  /**
   * Invoice Category Snapshot
   * Preserves the category information used by the invoice
   * even if the original category is modified later.
   */
  invoiceCategoryName        String? @map("invoice_category_name")
  invoiceCategoryCode        String? @map("invoice_category_code")
  invoiceCategoryDescription String? @map("invoice_category_description")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoiceCategory InvoiceCategory? @relation(fields: [invoiceCategoryId], references: [id], onDelete: SetNull)
  paymentMethod   PaymentMethod?   @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  items InvoiceItem[]

  @@unique([userId, invoiceNumber])
  @@unique([userId, slug])
  @@index([userId])
  @@index([clientId])
  @@index([invoiceCategoryId])
  @@index([paymentMethodId])
  @@index([status])
  @@index([invoiceDate])
  @@map("invoices")
}

/**
 * Invoice items
 */
model InvoiceItem {
  id        String @id @default(uuid())
  invoiceId String @map("invoice_id")

  description String
  quantity    Decimal
  rate        Decimal
  amount      Decimal

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}
